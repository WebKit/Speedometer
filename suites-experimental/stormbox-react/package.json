    "build": "vite build && node scripts/generate-resources.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.26",
    "dompurify": "3.4.7",
    "linkify-string": "4.3.3",
    "linkifyjs": "4.3.3",
    "lucide-react": "1.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "squire-rte": "2.4.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-svgr": "5.2.0"
  }
}
