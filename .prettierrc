{
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "css",
    "printWidth": 250,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "useTabs": false,
    "plugins": ["prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "suites-experimental/chat-room-angular/src/**/*.ts",
            "options": {
                "embeddedLanguageFormatting": "off"
            }
        }
    ]
}
